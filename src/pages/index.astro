---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { byNewest, byPinThenNewest, datelineShort, span } from "../lib/work";

const all = (await getCollection("work", ({ data }) => !data.draft)).sort(byNewest);
const featured = all.filter((p) => p.data.featured).sort(byPinThenNewest);
const range = span(all);
---

<Base
  title="Jason Moisiadis — work & writing"
  description="An archive of work, essays and experiments by Jason Moisiadis. Immersive experience designer, Sydney."
>
  <section class="wrap hero">
    <p class="label byline">Jason Moisiadis · they/he · Sydney</p>

    <h1 class="pixel">Turning messy&nbsp;problems into calm,&nbsp;working systems</h1>

    <p class="intro">
      I'm <a href="/about">an experience designer grounded in UX and service
      design</a>. Right now that's Tech Services at Lush — training,
      troubleshooting, and building the tooling that keeps a shop floor running
      when something breaks. It's less of a swerve than it sounds: working out
      what people actually need before you build them something is the same
      discipline whether the thing is an immersive experience or a stock system.
    </p>

    <p class="intro">
      This is the archive — essays, experiments and things I've made along the
      way.
    </p>
  </section>

  <section class="wrap featured">
    <div class="sec-head">
      <h2 class="label">Some things I've made</h2>
      <a class="all" href="/work">All {all.length} pieces, {range} →</a>
    </div>

    <ul class="cards">
      {
        featured.map((p) => (
          <li>
            <a href={`/work/${p.id}`} data-flood={p.data.flood} class="card">
              <span class="c-type">{p.data.type}</span>
              <span class="c-title">{p.data.title}</span>
              <span class="c-meta">{p.data.source} · {datelineShort(p)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero { padding-block-end: clamp(3rem, 12vh, 7rem); }

  .byline { margin-block-end: 1.4rem; }

  h1 {
    font-size: var(--step-4);
    line-height: .9;
    letter-spacing: 0;
    /* No measure cap. Display type at this size wants the whole column, and
       .wrap is already the limit — so the headline ends flush with the card
       grid below instead of stopping short of it. Two lines at desktop. */
  }

  .intro {
    /* Wider than --measure (66ch) on purpose: the hero should read as one
       column that finishes where the grid does. Still capped, so the line
       length can't run away if --wrap ever grows. */
    max-width: 74ch;
    font-size: var(--step-1);
    margin-block-start: 1.6rem;
    text-wrap: pretty;
  }

  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block-end: 1rem;
    border-bottom: 1.5px solid var(--fg);
  }

  .all {
    font-family: var(--font-pixel);
    font-size: var(--step-0);
    text-decoration: none;
  }
  .all:hover { text-decoration: underline; }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5px;
  }

  /* Order matters: these are min-width queries with equal specificity, so
     the wider breakpoint has to come last or the narrower one wins. */
  /* minmax(0, 1fr), not 1fr: a bare 1fr is minmax(auto, 1fr), and that auto
     floor is the track's min-content width. One long title — "The role of
     technology in the speculative future of HER" — was pushing its column to
     444px while the other two sat at 362px and 375px. Flooring at 0 lets the
     tracks divide evenly and the titles wrap instead. */
  @media (min-width: 700px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* every row the same height as the tallest, so the block reads as
         one grid rather than a set of independent tiles */
      grid-auto-rows: 1fr;
    }
  }

  @media (min-width: 1000px) {
    .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* The li is the grid item and stretches to the row; the anchor has to
     be told to fill it, or the container background shows through.
     min-width: 0 on both — grid items default to min-width: auto, which
     refuses to shrink below min-content. Without it the card stays as wide
     as its longest word and spills over the neighbouring tile. */
  .cards li { display: grid; min-width: 0; }

  .card {
    display: flex;
    flex-direction: column;
    gap: .6rem;
    height: 100%;
    min-height: clamp(200px, 26vw, 300px);
    min-width: 0;
    /* Makes the card a query container so the title can size against the
       tile rather than the viewport — see .c-title. */
    container-type: inline-size;
    padding: 1.5rem 1.4rem;
    text-decoration: none;
    background: var(--ground);
    color: var(--fg);
    outline: 1.5px solid var(--fg);
    transition: filter .25s ease;
  }
  .card:hover { filter: brightness(1.08) saturate(1.1); }

  .c-type {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: .16em;
    text-transform: uppercase;
    opacity: .8;
  }

  .c-title {
    /* Sized against the tile (cqi), not the viewport, so the type shrinks to
       fit the box instead of the box stretching to fit the type. --step-3 is
       the ceiling, so short titles still get the full display size. 12cqi
       keeps the longest word here — SUPERPOSITION — whole at every
       breakpoint; overflow-wrap below is the backstop if a longer one lands. */
    font-size: clamp(1.75rem, 12cqi, var(--step-3));
    font-weight: 700;
    line-height: .95;
    letter-spacing: -.03em;
    text-transform: uppercase;
    margin-block-start: auto;
    text-wrap: balance;
    /* break-word only splits a word that genuinely cannot fit, so
       "SUPERPOSITION" stays whole instead of becoming SUPERPOSIT / ION */
    overflow-wrap: break-word;
    min-width: 0;
  }

  .c-meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: .1em;
    opacity: .8;
  }
</style>
