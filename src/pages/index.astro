---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { byNewest, byPinThenNewest, datelineShort, span } from "../lib/work";

const all = (await getCollection("work", ({ data }) => !data.draft)).sort(byNewest);
const featured = all.filter((p) => p.data.featured).sort(byPinThenNewest).slice(0, 6);
const range = span(all);
---

<Base
  title="Jason Moisiadis — work &amp; writing"
  description="An archive of work, essays and experiments by Jason Moisiadis. Immersive experience designer, Sydney."
>
  <section class="wrap hero">
    <div class="hero-top">
      <h1 class="pixel">me</h1>

      <dl class="meta">
        <div><dt>Who</dt><dd>Jason Moisiadis · they/he</dd></div>
        <div><dt>Where</dt><dd>Sydney</dd></div>
        <div><dt>Currently</dt><dd>Tech Services, Lush · 3 years</dd></div>
      </dl>
    </div>

    <p class="intro">
      I turn messy problems into calm, working systems. I got here through
      immersive and user-centred design, and it's less of a swerve than it
      sounds: working out what people actually need before you build them
      something is the same discipline whether the thing is an immersive
      experience or a stock system.
    </p>
  </section>

  <section class="wrap featured">
    <div class="sec-head">
      <h2 class="label">Some things I've made</h2>
      <a class="all" href="/work">All {all.length} pieces, {range} →</a>
    </div>

    <ul class="cards">
      {
        featured.map((p) => (
          <li>
            <a href={`/work/${p.id}`} data-flood={p.data.flood} class="card">
              <span class="c-type">{p.data.type}</span>
              <span class="c-title">{p.data.title}</span>
              <span class="c-meta">{p.data.source} · {datelineShort(p)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero { padding-block-end: clamp(3rem, 12vh, 7rem); }

  /* One word, and a small block of facts holding the other side of the line. */
  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
    padding-block-end: 1rem;
    border-bottom: 1.5px solid var(--fg);
  }

  h1 {
    font-size: clamp(4rem, 16vw, 11rem);
    line-height: .8;
    letter-spacing: 0;
  }

  .meta {
    margin: 0;
    display: grid;
    gap: .35rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: .08em;
    text-align: right;
  }
  .meta div { display: flex; gap: .6rem; justify-content: flex-end; }
  .meta dt { text-transform: uppercase; color: var(--fg-soft); }
  .meta dd { margin: 0; }

  .intro {
    max-width: var(--measure);
    font-size: var(--step-1);
    margin-block-start: 1.6rem;
    text-wrap: pretty;
  }

  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block-end: 1rem;
    border-bottom: 1.5px solid var(--fg);
  }

  .all {
    font-family: var(--font-pixel);
    font-size: var(--step-0);
    text-decoration: none;
  }
  .all:hover { text-decoration: underline; }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--fg);
    border: 1.5px solid var(--fg);
    border-block-start: 0;
  }

  /* Two across, not four. At four the cards were ~260px, which is too
     narrow for uppercase display type — long titles had nowhere to go. */
  @media (min-width: 1000px) {
    .cards { grid-template-columns: repeat(3, 1fr); }
  }

  @media (min-width: 700px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
      /* every row the same height as the tallest, so the whole block
         reads as one grid rather than four independent tiles */
      grid-auto-rows: 1fr;
    }
  }

  /* The li is the grid item and stretches to the row; the anchor has to
     be told to fill it, or the container background shows through. */
  .cards li { display: grid; }

  .card {
    display: flex;
    flex-direction: column;
    gap: .6rem;
    height: 100%;
    min-height: clamp(200px, 26vw, 300px);
    padding: 1.5rem 1.4rem;
    text-decoration: none;
    background: var(--ground);
    color: var(--fg);
    transition: filter .25s ease;
  }
  .card:hover { filter: brightness(1.08) saturate(1.1); }

  .c-type {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: .16em;
    text-transform: uppercase;
    opacity: .8;
  }

  .c-title {
    font-size: var(--step-3);
    font-weight: 700;
    line-height: .95;
    letter-spacing: -.03em;
    text-transform: uppercase;
    margin-block-start: auto;
    text-wrap: balance;
    /* break-word only splits a word that genuinely cannot fit, so
       "SUPERPOSITION" stays whole instead of becoming SUPERPOSIT / ION */
    overflow-wrap: break-word;
    min-width: 0;
  }

  .c-meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: .1em;
    opacity: .8;
  }
</style>
