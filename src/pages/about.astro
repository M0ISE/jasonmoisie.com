---
import Base from "../layouts/Base.astro";

/** A piece of work under a role. `href` points at the archive when one exists. */
type Project = {
  year: string;
  text: string;
  href?: string;
};

type Role = {
  years: string;
  role: string;
  note: string;
  /** The role currently held. Draws the ● marker. */
  current?: boolean;
  /** Store or site, where it differs from the employer's own location. */
  place?: string;
  projects?: Project[];
};

type Employer = {
  org: string;
  place: string;
  span: string;
  /** Only set where the total time is worth stating on its own. */
  tenure?: string;
  roles: Role[];
};

/**
 * Grouped by employer, not by role. Three years at Lush was invisible when
 * every title sat as its own entry — the tenure is the point, the titles are
 * the detail underneath it.
 */
const experience: Employer[] = [
  {
    org: "Lush Fresh Handmade Cosmetics",
    place: "Australia & Aotearoa",
    span: "Oct 2023 — present",
    tenure: "3 years",
    roles: [
      {
        years: "2025 — present",
        current: true,
        role: "Operational Specialist, Tech Services",
        note: "Supporting stores and factories across Australia and Aotearoa on the systems they run on — training, troubleshooting, and refining the tools that keep a shop floor working when something breaks.",
        projects: [
          {
            year: "2025 – 2026",
            text: "Lush Pay phase 2 — point-of-sale hardware rollout. Procurement and logistics for dozens of Epson TM-L100 label printers and CAS PND till scales, working out what deployment actually looks like in store and tailoring the install with each store's leadership team. Budgeting, vendor negotiation, and hands-on provisioning down to custom IP setups. I was on the shop floor for phase 1, so I took what went wrong there into how phase 2 was run.",
          },
          {
            year: "2026",
            text: "B.O.T — a support bot so stores can solve in-a-pinch tech issues when Tech Services isn't available. I saw a need on my team while I was on leave and built a tool to help cover it.",
            href: "/work/bot-ai-chat-helper",
          },
          {
            year: "2026",
            text: "Long-lead click and collect — localising the global system. Coordinating process and training across Digital Fulfilment, store teams and the UK dev team so it arrived working rather than just arriving.",
          },
          {
            year: "2026",
            text: "Mobile device management and fleet provisioning. Built configuration profiles in ScaleFusion for mass enrolment of Zebra TC27 scanners, till tablets, back-of-house tablets and store phones.",
          },
          {
            year: "2025",
            text: "Took my experience piloting the new POS system straight into training stores how to use it.",
          },
        ],
      },
      {
        years: "2025",
        role: "Assistant Manager",
        place: "Parramatta",
        note: "Piloted a new point-of-service and stock management system for our region and the country, then ran troubleshooting and onboarding for the rest of the region. Led the team through a visual merchandising realignment, and moved ordering closer to what the store actually needed to cut waste.",
      },
      {
        years: "2024 – 2025",
        role: "Supervisor",
        place: "QVB",
        note: "Onboarding and up-skilling the team, designing incentives against our targets, and building Power BI reports on customer trends — then using them to steer ordering, stock allocation, and to measure whether a merchandising change actually moved anything. Also ran the product-making workshops and parties.",
      },
      {
        years: "2023 – 2024",
        role: "Sales Assistant",
        place: "QVB",
        note: "Consults, stock, payments and POS, opening and closing.",
      },
    ],
  },
  {
    org: "The Organic Bread Bar",
    place: "Paddington",
    span: "Nov 2022 — Jun 2023",
    roles: [
      {
        years: "2022 – 2023",
        role: "Evening Barista",
        note: "Coffee, bread and pastry service, close-down and cash-up, wholesale production sheets, and training new starters on the particulars of an evening shift.",
      },
    ],
  },
  {
    org: "Bluebottle Espresso",
    place: "Manly",
    span: "Jun — Nov 2022",
    roles: [
      {
        years: "2022",
        role: "Barista & All-Rounder",
        note: "Front of house through weekend rushes — coffee, kitchen prep, POS.",
      },
    ],
  },
];

const education = [
  {
    years: "2021 – 2023",
    award: "Master of Visualisation, Simulation & Immersive Design",
    place: "University of New South Wales",
  },
  {
    years: "2017 – 2020",
    award: "Bachelor of Design Computing",
    place: "University of Sydney",
  },
  {
    years: "2016",
    award: "Bachelor of Electrical Engineering & Nanotechnology",
    place: "University of Technology Sydney",
  },
];

---

<Base
  title="About — Jason Moisiadis"
  description="Experience designer in Sydney. UX and service design, narrative design, simulation and modelling — currently in Tech Services at Lush."
>
  <section class="wrap">
    {/* Same header pattern as the archive: title left, facts right, rule
        under. The page is the record, so it starts at the record. */}
    <header class="head">
      <h1>About</h1>
      <p class="label">Jason Moisiadis · they/he · Sydney</p>
    </header>

    <div class="cols">
      <div class="main">
        <section class="block">
          <h2 class="label">Experience ↓</h2>

          {
            experience.map((org) => (
              <article class="org">
                <header class="org-head">
                  <h3 class="org-name">
                    {org.org} <span class="org-place">— {org.place}</span>
                  </h3>
                  <p class="org-span">
                    {org.span}
                    {org.tenure && <span class="tenure">{org.tenure}</span>}
                  </p>
                </header>

                <ul class="roles">
                  {org.roles.map((r) => (
                    <li>
                      <span class="e-years">
                        {r.years}
                        {r.current && <span class="now" aria-label="current role">●</span>}
                      </span>
                      <div>
                        <h4 class="e-role">
                          {r.role}
                          {r.place && <span class="e-place"> — {r.place}</span>}
                        </h4>
                        <p class="e-note">{r.note}</p>
                        {r.projects && (
                          <ul class="proj">
                            {r.projects.map((p) => (
                              <li>
                                <span class="p-year">{p.year}</span>
                                {p.href ? <a href={p.href}>{p.text}</a> : p.text}
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </section>

      </div>

      <aside class="side">
        <section class="block">
          <h2 class="label">Education ↓</h2>
          <ul class="edu">
            {
              education.map((e) => (
                <li>
                  <span class="e-years">{e.years}</span>
                  <span class="ed-award">{e.award}</span>
                  <span class="ed-place">{e.place}</span>
                </li>
              ))
            }
          </ul>
        </section>

        {/* The two that matter, in reach without scrolling to the footer.
            LinkedIn, GitHub and the rest live down there. */}
        <section class="block">
          <h2 class="label">Contact ↓</h2>
          <ul class="links">
            <li><a href="mailto:jason.moisie@gmail.com">→ Email</a></li>
            <li><a href="tel:+61420288843">→ Phone</a></li>
          </ul>
        </section>

        <section class="block">
          <h2 class="label">Photography ↓</h2>
          <p class="side-note">
            I take a lot of photos. They live on Instagram rather than here.
          </p>
          <ul class="links">
            <li>
              <a href="https://www.instagram.com/moisie.jpg/" rel="me noopener">
                → @moisie.jpg ▨
              </a>
            </li>
          </ul>
        </section>

        {/* Same 1-bit mask trick as the archive imagery: one file, painted
            with currentColor, so it reads as ink on paper and paper in dark
            mode without shipping a second copy. */}
        <section class="block">
          <h2 class="label">Me ↓</h2>
          <div
            class="dither portrait"
            role="img"
            aria-label="Jason looking up at the camera, grinning, in front of the glass wall of the Met's Sackler Wing with Fifth Avenue buildings behind it"
            style="--img: url(/images/dither/me.png);"
          >
          </div>
        </section>
      </aside>
    </div>
  </section>
</Base>

<style>
  /* Mirrors .head on the archive page — same rule, same baseline alignment,
     so the two top-level pages open identically. */
  .head {
    padding-block-end: 1rem;
    border-bottom: 1.5px solid var(--fg);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  h1 {
    font-size: var(--step-3);
    text-transform: uppercase;
    letter-spacing: -.03em;
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 4rem);
    margin-block-start: clamp(2.5rem, 7vh, 4rem);
  }
  @media (min-width: 900px) {
    .cols { grid-template-columns: minmax(0, 1.7fr) minmax(220px, .8fr); }
  }

  .block + .block { margin-block-start: 2.6rem; }
  .block > h2 { padding-block-end: .5rem; border-bottom: 1px solid var(--rule); }

  ul { list-style: none; margin: 0; padding: 0; }

  /* --- employer grouping --- */
  .org { margin-block-start: 2rem; }

  .org-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block-end: .5rem;
    border-bottom: 1.5px solid var(--fg);
  }
  .org-name {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -.01em;
  }
  .org-place { font-weight: 400; color: var(--fg-soft); }
  .org-span {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: .1em;
    color: var(--fg-soft);
    display: flex;
    align-items: center;
    gap: .6rem;
    white-space: nowrap;
  }
  .tenure {
    border: 1px solid var(--rule);
    padding: .1rem .45rem;
    color: var(--fg);
  }

  /* direct children only — nested project lists must not inherit this */
  .roles > li {
    display: grid;
    grid-template-columns: 1fr;
    gap: .35rem;
    padding-block: 1.2rem;
  }
  .roles > li + li { border-top: 1px solid var(--rule); }
  @media (min-width: 620px) {
    .roles > li { grid-template-columns: 9.5rem 1fr; gap: 1.2rem; }
  }

  .e-years {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: .1em;
    color: var(--fg-soft);
    padding-block-start: .3em;
    display: flex;
    align-items: baseline;
    gap: .4rem;
  }
  .now { color: var(--flood-green); font-size: .7em; }

  .e-role {
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -.015em;
  }
  .e-place { font-weight: 400; color: var(--fg-soft); }

  .e-note {
    margin-block-start: .45rem;
    color: var(--fg-soft);
    max-width: 58ch;
    text-wrap: pretty;
  }

  .proj {
    margin-block-start: .9rem;
    display: flex;
    flex-direction: column;
    gap: .55rem;
    max-width: 58ch;
  }
  .proj li {
    position: relative;
    padding-inline-start: 1.1rem;
    font-size: var(--step--1);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .proj li::before {
    content: "♦";
    position: absolute;
    inset-inline-start: 0;
    color: var(--accent);
  }
  .p-year {
    font-family: var(--font-mono);
    letter-spacing: .1em;
    color: var(--fg-soft);
    margin-inline-end: .5em;
  }

  /* --- sidebar --- */
  .side {
    display: flex;
    flex-direction: column;
    /* Breathing room above the sidebar when it is stuck, and the same again
       below it when it has to scroll itself. */
    --side-gap: clamp(1.5rem, 4vh, 2.5rem);
  }

  /* Sticky only where there are two columns to be beside. The sidebar runs
     out well before the experience list does, so it follows instead of
     leaving a long empty gutter. */
  @media (min-width: 900px) {
    .side {
      position: sticky;
      /* Without this the grid stretches .side to the full row height and
         sticky has no slack to travel in. */
      align-self: start;
      top: var(--side-gap);
      /* The sidebar is ~816px. On a short window that is taller than the
         viewport, and a plain top-pin would strand the last block
         off-screen for the whole scroll. Cap it and let it scroll itself
         instead — the scrollbar only appears when it is actually needed. */
      max-height: calc(100dvh - var(--side-gap) * 2);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }
  }

  .side-note {
    margin-block-start: .8rem;
    font-size: var(--step--1);
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  /* The mask is square and generated at 580px for a ~290px column, so it
     lands 1:1 on a retina screen. Capped so it can't outgrow that on a wide
     viewport, where a non-integer downscale would muddy the grain. */
  .portrait {
    width: 100%;
    max-width: 290px;
    aspect-ratio: 3 / 4;
    margin-block-start: .9rem;
    background-color: currentColor;
    -webkit-mask: var(--img) center / contain no-repeat;
    mask: var(--img) center / contain no-repeat;
  }

  .links { margin-block-start: .9rem; display: flex; flex-direction: column; gap: .45rem; }
  .links a {
    font-family: var(--font-pixel);
    font-size: var(--step-1);
    text-decoration: none;
    display: inline-block;
  }
  .links a:hover { text-decoration: underline; text-decoration-thickness: 2px; }

  .edu { margin-block-start: 1.1rem; display: flex; flex-direction: column; gap: 1.3rem; }
  .edu li { display: flex; flex-direction: column; gap: .15rem; }
  .ed-award { font-weight: 700; line-height: 1.25; }
  .ed-place { font-size: var(--step--1); color: var(--fg-soft); }

</style>
