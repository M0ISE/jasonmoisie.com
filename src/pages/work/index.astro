---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

/** Ongoing work belongs to its most recent year, not the year it started. */
const shelf = (p: { data: { year: number; endYear?: number } }) =>
  p.data.endYear ?? p.data.year;

const all = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => shelf(b) - shelf(a) || a.data.title.localeCompare(b.data.title)
);

// group by year, newest first — the archive reads as a timeline
const years = [...new Set(all.map(shelf))].sort((a, b) => b - a);
const span = `${Math.min(...all.map((p) => p.data.year))}–${Math.max(...all.map(shelf))}`;
---

<Base
  title="Work — Jason Moisiadis"
  description={`An archive of essays, projects and experiments, ${span}.`}
>
  <section class="wrap">
    <header class="head">
      <h1>The archive</h1>
      <p class="label">{all.length} pieces · {span}</p>
    </header>

    {
      years.map((year) => (
        <section class="year-block">
          <h2 class="year label">{year}</h2>
          <ul>
            {all
              .filter((p) => shelf(p) === year)
              .map((p) => (
                <li>
                  <a href={`/work/${p.id}`}>
                    <span
                      class="dot"
                      style={`--dot: var(--flood-${p.data.flood})`}
                      aria-hidden="true"
                    />
                    <span class="t">{p.data.title}</span>
                    <span class="s">{p.data.summary}</span>
                    <span class="m">
                      {p.data.type} · {p.data.source}
                      {p.data.pdf ? " · PDF" : ""}
                    </span>
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </section>
</Base>

<style>
  .head {
    padding-block-end: 1rem;
    border-bottom: 1.5px solid var(--fg);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  h1 {
    font-size: var(--step-3);
    text-transform: uppercase;
    letter-spacing: -.03em;
  }

  .year-block { margin-block-start: clamp(2.2rem, 6vh, 3.4rem); }

  .year {
    font-family: var(--font-pixel);
    font-size: var(--step-1);
    letter-spacing: .1em;
    color: var(--fg-soft);
    padding-block-end: .5rem;
    border-bottom: 1px solid var(--rule);
  }

  ul { list-style: none; margin: 0; padding: 0; }

  li + li { border-top: 1px solid var(--rule); }

  li a {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "dot title"
      ".   summ"
      ".   meta";
    column-gap: .85rem;
    row-gap: .3rem;
    padding-block: 1.15rem;
    text-decoration: none;
  }

  .dot {
    grid-area: dot;
    width: 14px;
    height: 14px;
    margin-block-start: .42em;
    background: var(--dot);
    border: 1.5px solid var(--fg);
  }

  .t {
    grid-area: title;
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.025em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .s {
    grid-area: summ;
    color: var(--fg-soft);
    max-width: var(--measure);
    text-wrap: pretty;
  }

  .m {
    grid-area: meta;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--fg-soft);
  }

  li a:hover .t { text-decoration: underline; text-decoration-thickness: 2px; }
  li a:hover .dot { transform: scale(1.35); }
  .dot { transition: transform .2s ease; }
</style>
