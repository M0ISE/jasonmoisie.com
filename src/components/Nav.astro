---
const { pathname } = Astro.url;
const isHome = pathname === "/" || pathname === "";
const isWork = pathname.startsWith("/work");
const isAbout = pathname.startsWith("/about");
---

<nav aria-label="Primary">
  <ul>
    <li>
      <a class="home" href="/" aria-current={isHome ? "page" : undefined}>
        <span class="glyph" aria-hidden="true"></span>
        <span class="sr-only">Home</span>
      </a>
    </li>
    <li><a href="/work" aria-current={isWork ? "page" : undefined}>The Work ✨</a></li>
    <li><a href="/about" aria-current={isAbout ? "page" : undefined}>The Human ☕</a></li>
  </ul>
</nav>

<style>
  nav { padding-block: 1.1rem 0; }

  ul {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 3vw, 2.4rem);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  a {
    font-family: var(--font-pixel);
    font-size: var(--step-1);
    text-decoration: none;
    white-space: nowrap;
  }

  a:hover,
  a:focus-visible { text-decoration: underline; text-decoration-thickness: 2px; }

  a[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 2px; }

  /* The mark: an empty square that fills in when you reach for it. */
  .home {
    font-size: var(--step-2);
    line-height: 1;
    text-decoration: none;
  }
  .home:hover,
  .home:focus-visible,
  .home[aria-current="page"] { text-decoration: none; }

  .glyph::before {
    content: "■";
    display: inline-block;
  }

  /* On hover the mark runs through the archive's flood colours — the same
     five that paint the work pages. */
  .home:hover .glyph::before,
  .home:focus-visible .glyph::before {
    background: linear-gradient(
      90deg,
      var(--flood-blue),
      var(--flood-purple),
      var(--flood-red),
      var(--riso-orange),
      var(--flood-tan),
      var(--flood-green),
      var(--flood-blue)
    );
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: flood-cycle .7s linear infinite;
  }

  @keyframes flood-cycle {
    from { background-position: 0 0; }
    to { background-position: -300% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home:hover .glyph::before,
    .home:focus-visible .glyph::before { animation: none; }
  }
</style>
