---
const { pathname } = Astro.url;
const isHome = pathname === "/" || pathname === "";
const isWork = pathname.startsWith("/work");
const isAbout = pathname.startsWith("/about");
---

<nav aria-label="Primary">
  <!--
    ΗΟΜΕ is Greek — Eta, Omicron, Mu, Epsilon. It reads as HOME and is a nod
    to Jason's Greek background. Verified present in PP Mondwest rather than
    silently falling back. aria-label carries the Latin word so a screen
    reader announces "Home" and not four Greek letters.
  -->
  <a class="home" href="/" aria-label="Home" aria-current={isHome ? "page" : undefined}>
    <span class="greek" lang="el" aria-hidden="true">ΗΟΜΕ</span>
  </a>

  <ul>
    <li><a href="/work" aria-current={isWork ? "page" : undefined}>Archive</a></li>
    <li><a href="/about" aria-current={isAbout ? "page" : undefined}>About</a></li>
  </ul>
</nav>

<style>
  nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem clamp(1rem, 3vw, 2.4rem);
    flex-wrap: wrap;
    padding-block: 1.1rem 0;
  }

  ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2.4rem);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  a {
    font-family: var(--font-pixel);
    font-size: var(--step-1);
    text-decoration: none;
    white-space: nowrap;
  }

  ul a:hover,
  ul a:focus-visible,
  ul a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  /* The mark runs through the archive's flood colours on hover — the same
     five that paint the work pages, plus a true orange. */
  .home {
    font-size: var(--step-2);
    letter-spacing: .06em;
  }

  .home:hover .greek,
  .home:focus-visible .greek,
  .home[aria-current="page"] .greek {
    background: linear-gradient(
      90deg,
      var(--flood-blue),
      var(--flood-purple),
      var(--flood-red),
      var(--riso-orange),
      var(--flood-tan),
      var(--flood-green),
      var(--flood-blue)
    );
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .home:hover .greek,
  .home:focus-visible .greek {
    animation: flood-cycle .7s linear infinite;
  }

  @keyframes flood-cycle {
    from { background-position: 0 0; }
    to { background-position: -300% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home:hover .greek,
    .home:focus-visible .greek { animation: none; }
  }
</style>
