---
const { pathname } = Astro.url;
const isHome = pathname === "/" || pathname === "";
const isWork = pathname.startsWith("/work");
const isAbout = pathname.startsWith("/about");
---

<nav aria-label="Primary">
  <ul>
    <li><a href="/" aria-current={isHome ? "page" : undefined}>Home 🏠</a></li>
    <li><a href="/work" aria-current={isWork ? "page" : undefined}>The Work ✨</a></li>
    <li><a href="/about" aria-current={isAbout ? "page" : undefined}>About Me ☕</a></li>
  </ul>
</nav>

<style>
  nav { padding-block: 1.1rem 0; }

  ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2.4rem);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  a {
    font-family: var(--font-pixel);
    font-size: var(--step-1);
    text-decoration: none;
    white-space: nowrap;
  }

  a:hover,
  a:focus-visible { text-decoration: underline; text-decoration-thickness: 2px; }

  a[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 2px; }
</style>
