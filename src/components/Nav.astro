---
const { pathname } = Astro.url;
const isWork = pathname.startsWith("/work");
const isAbout = pathname.startsWith("/about");
---

<nav aria-label="Primary">
  <a class="mark" href="/" aria-label="Jason Moisiadis — home">
    <span class="glyph" aria-hidden="true"></span>
  </a>

  <ul>
    <li><a href="/work" aria-current={isWork ? "page" : undefined}>Work ✨</a></li>
    <li>
      <a href="https://www.instagram.com/moisie.jpg/" rel="me noopener">
        Photography ▨
      </a>
    </li>
    <li><a href="/about" aria-current={isAbout ? "page" : undefined}>About ☕</a></li>
  </ul>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.4rem);
    flex-wrap: wrap;
    padding-block: 1.1rem 0;
  }

  .mark {
    display: block;
    line-height: 0;
    flex: none;
  }

  /* Masked so the mark always takes --accent: purple on paper and dark
     grounds, the flood's paired foreground on a flood page. One asset,
     never clashes. */
  .glyph {
    display: block;
    width: 34px;
    aspect-ratio: 10576 / 7813;
    background: var(--accent);
    -webkit-mask: url("/brand/nav-purple.png") center / contain no-repeat;
    mask: url("/brand/nav-purple.png") center / contain no-repeat;
  }

  ul {
    display: flex;
    gap: clamp(.9rem, 2.5vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  a {
    font-family: var(--font-pixel);
    font-size: var(--step-1);
    text-decoration: none;
    white-space: nowrap;
  }

  ul a:hover,
  ul a:focus-visible { text-decoration: underline; text-decoration-thickness: 2px; }

  ul a[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 2px; }
</style>
